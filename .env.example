# =============================================================================
# douyin-huohua-keeper 环境配置
#
# 用法：
#   cp .env.example .env
#   改掉 HUOHUA_TOKEN（必须），按需配置通知通道
#
# 生成一个够强的令牌：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================


# -----------------------------------------------------------------------------
# 工作台访问
# -----------------------------------------------------------------------------

# 访问令牌（**必须设置**）。
# 留空的话工作台会对任何能访问到端口的人开放 —— 而那里有你的抖音登录二维码。
HUOHUA_TOKEN=

# 监听地址与端口
# 只在本机用就改成 127.0.0.1，配合 SSH 隧道访问，安全得多
HUOHUA_HOST=0.0.0.0
HUOHUA_PORT=8787

# 来源 IP 白名单（推荐）。
# 逗号分隔，支持单个 IP 和 CIDR。留空表示不限制。
# 例：HUOHUA_ALLOWED_IPS=203.0.113.7,198.51.100.0/24
# 注意：家里宽带是动态 IP 的话，这里写死会把自己关在门外。
HUOHUA_ALLOWED_IPS=


# -----------------------------------------------------------------------------
# 时间与时区
# -----------------------------------------------------------------------------

# 火花按「自然日」计算，时区错了发送窗口就会错。
# 服务器在境外时这一项尤其重要。
TZ=Asia/Shanghai


# -----------------------------------------------------------------------------
# 存储位置
# -----------------------------------------------------------------------------

# 数据根目录。下面会自动创建 accounts/ config/ runs/ 三个子目录。
HUOHUA_DATA_DIR=data

# 日志目录
HUOHUA_LOG_DIR=logs


# -----------------------------------------------------------------------------
# 浏览器
# -----------------------------------------------------------------------------

# 无头模式。容器和服务器上必须为 true（没有图形界面会启动失败）。
# 本地调试时设成 false，能亲眼看到它在点什么，排查问题时非常有用。
HUOHUA_HEADLESS=true

# 自定义浏览器可执行文件路径（可选）。
# 不填则用 Playwright 自带的那份。系统里已有 Chromium 时可以用这个省空间。
# HUOHUA_BROWSER_PATH=/usr/bin/chromium

# 浏览器启动超时（毫秒）
HUOHUA_BROWSER_TIMEOUT_MS=60000

# 页面导航超时（毫秒）。网络慢的话调大。
HUOHUA_NAV_TIMEOUT_MS=45000

# 页面操作超时（毫秒）
HUOHUA_ACTION_TIMEOUT_MS=15000

# 每步操作之间的慢速系数（毫秒）。
# 设为 0 最快；设为 100~300 会让动作看起来更像人在操作。
# 注意：这只影响观感，**不能规避平台风控**。
HUOHUA_SLOW_MO_MS=0

# 工作台的「共享浏览器」空闲多少秒后自动关闭（0 = 不回收）。
# 同步收件人 / 好友列表用的那个浏览器用过之后会一直留在进程里（约 600MB），
# 而定时任务又会另起一个 —— 小内存机器（1~2GB）会同时存在两个 Chromium。
# 保留默认值即可：平时常驻压回几十 MB，只在你真要用的那几秒才拉起浏览器。
HUOHUA_ENGINE_IDLE_TIMEOUT_SEC=600

# 出错的运行是否截图存证（存到 data/runs/<run_id>/ 下）
HUOHUA_CAPTURE_ON_ERROR=true

# 保存 Playwright Trace（诊断用，体积较大，默认关）
HUOHUA_TRACE=false


# -----------------------------------------------------------------------------
# 发送行为
# -----------------------------------------------------------------------------

# 发送终态确认总超时（毫秒）。
# 引擎发完消息后会等「终态」出现（消息真正落到会话列表）才算成功，
# 这个值决定最多等多久。网慢就调大。
HUOHUA_CONFIRM_TIMEOUT_MS=15000

# 同一轮里两个收件人之间等待的秒数区间，随机取值。
# 目的是避免多个收件人在同一秒被发送。
HUOHUA_SEND_GAP_MIN_SEC=20
HUOHUA_SEND_GAP_MAX_SEC=90

# 每个收件人失败后的重试次数（只对可重试类错误生效）
HUOHUA_MAX_RETRIES=3

# 重试间隔（秒）
HUOHUA_RETRY_BACKOFF_SEC=30

# 检测到疑似风控后，本次运行剩余收件人的等待时间（秒）
HUOHUA_RISK_COOLDOWN_SEC=300


# -----------------------------------------------------------------------------
# 调度
# -----------------------------------------------------------------------------

# 是否启用进程内调度器。
# 用 Docker / systemd 常驻服务时保持 true —— 网页上改完时间立刻生效。
# 用 cron 触发的话设 false，避免两套调度打架。
HUOHUA_ENABLE_SCHEDULER=true

# 跑完一次就退出（cron 场景配合使用）
HUOHUA_RUN_ONCE=false

# 触发时间的抖动范围（分钟）。
# 不设的话每天 10:30:00 准点发送，时间戳整齐得不像人。
HUOHUA_JITTER_MINUTES=25


# -----------------------------------------------------------------------------
# 通知通道
# -----------------------------------------------------------------------------

# 启用的通道，逗号分隔。留空表示不通知 —— 那么失败只有你自己打开网页才知道。
# 可选：bark, serverchan, dingtalk, feishu, telegram, webhook
HUOHUA_NOTIFY_CHANNELS=

# --- Bark（iOS，最省事，推荐）---
# 形如 https://api.day.app/你的Key
HUOHUA_BARK_URL=

# --- Server酱（微信推送）---
# 填 SendKey
HUOHUA_SERVERCHAN_KEY=

# --- 钉钉机器人（webhook 与 secret 都要填）---
HUOHUA_DINGTALK_WEBHOOK=
HUOHUA_DINGTALK_SECRET=

# --- 飞书机器人 ---
HUOHUA_FEISHU_WEBHOOK=

# --- Telegram ---
HUOHUA_TELEGRAM_BOT_TOKEN=
HUOHUA_TELEGRAM_CHAT_ID=

# --- 通用 Webhook（POST JSON）---
HUOHUA_GENERIC_WEBHOOK=

# 通知通道自身的重试次数与超时
HUOHUA_NOTIFY_RETRIES=2
HUOHUA_NOTIFY_TIMEOUT_SEC=10


# -----------------------------------------------------------------------------
# 告警阈值
# -----------------------------------------------------------------------------

# 连续失败多少天发 WARNING。设为 0 表示不告警。
HUOHUA_WARN_THRESHOLD=2

# 连续失败多少天发 CRITICAL。必须大于上面的值，否则永远不会升级。
HUOHUA_CRITICAL_THRESHOLD=3

# ⚠️ 注意：上面这两个只影响**跨天连续失败**的升级级别。
# 「某一轮里真的有人没发出去」永远会立刻推送（标题里带失败人数），
# 不需要等到连续两天 —— 这是刻意的：火花断了当天就该知道。


# -----------------------------------------------------------------------------
# 每日汇总
# -----------------------------------------------------------------------------

# 每晚固定推一条「今天整体怎么样」（跑了几次、成功/失败各几人）。
HUOHUA_DIGEST_ENABLED=true
HUOHUA_DIGEST_HOUR=23
HUOHUA_DIGEST_MINUTE=30


# -----------------------------------------------------------------------------
# 日志
# -----------------------------------------------------------------------------

# DEBUG / INFO / WARNING / ERROR
HUOHUA_LOG_LEVEL=INFO
